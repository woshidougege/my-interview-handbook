<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    
    <id>dist</id>
    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>

    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>super-agent-${project.version}</baseDirectory>

    <fileSets>
        <!-- 启动脚本 -->
        <fileSet>
            <directory>src/main/scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <includes>
                <include>*.sh</include>
                <include>*.bat</include>
            </includes>
        </fileSet>

        <!-- 主配置文件 -->
        <fileSet>
            <directory>src/main/resources</directory>
            <outputDirectory>conf</outputDirectory>
            <includes>
                <include>application.yml</include>
                <include>application-*.yml</include>
                <include>logback-spring.xml</include>
            </includes>
        </fileSet>

        <!-- 数据库迁移脚本 -->
        <fileSet>
            <directory>src/main/resources/db</directory>
            <outputDirectory>conf/db</outputDirectory>
            <includes>
                <include>migration/*.sql</include>
            </includes>
        </fileSet>

        <!-- 静态资源文件 -->
        <fileSet>
            <directory>src/main/resources/static</directory>
            <outputDirectory>conf/static</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!-- 模板文件 -->
        <fileSet>
            <directory>src/main/resources/templates</directory>
            <outputDirectory>conf/templates</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!-- META-INF文件 -->
        <fileSet>
            <directory>src/main/resources/META-INF</directory>
            <outputDirectory>conf/META-INF</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <!-- 创建日志目录 -->
        <fileSet>
            <directory>src/main/scripts</directory>
            <outputDirectory>logs</outputDirectory>
            <excludes>
                <exclude>**/*</exclude>
            </excludes>
        </fileSet>

    </fileSets>

    <dependencySets>
        <!-- 第三方依赖 - 放到lib目录 -->
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <excludes>
                <!-- 排除本项目的模块，这些会单独处理 -->
                <exclude>com.noah:super-agent-common</exclude>
                <exclude>com.noah:super-agent-dao</exclude>
                <exclude>com.noah:super-agent-service-api</exclude>
                <exclude>com.noah:super-agent-service-impl</exclude>
                <exclude>com.noah:super-agent-web</exclude>
                <exclude>com.noah:super-agent-scheduler</exclude>
            </excludes>
        </dependencySet>

        <!-- 业务模块依赖 - 放到modules目录 -->
        <dependencySet>
            <outputDirectory>modules</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <includes>
                <include>com.noah:super-agent-boot</include>
                <include>com.noah:super-agent-common</include>
                <include>com.noah:super-agent-dao</include>
                <include>com.noah:super-agent-service-api</include>
                <include>com.noah:super-agent-service-impl</include>
                <include>com.noah:super-agent-web</include>
                <include>com.noah:super-agent-scheduler</include>
            </includes>
            <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
        </dependencySet>
    </dependencySets>
</assembly>
