<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.noah</groupId>
    <artifactId>super-agent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Super Agent Platform</name>
    <description>用户管理和计费平台 - 父模块</description>

    <modules>
        <module>super-agent-common</module>
        <module>super-agent-dao</module>
        <module>super-agent-service-api</module>
        <module>super-agent-service-impl</module>
        <module>super-agent-web</module>
        <module>super-agent-scheduler</module>
        <module>super-agent-boot</module>
    </modules>

    <properties>
        <!-- 项目版本 -->
        <revision>1.0.0-SNAPSHOT</revision>
        
        <!-- Java版本 -->
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <!-- 强制设置文件编码 -->
        <file.encoding>UTF-8</file.encoding>
        <sun.jnu.encoding>UTF-8</sun.jnu.encoding>
        
        <!-- Spring Boot版本 -->
        <spring-boot.version>2.7.18</spring-boot.version>
        
        <!-- 数据库相关版本 -->
        <mybatis-flex.version>1.11.1</mybatis-flex.version>
        <!-- MySQL版本（保留备用） -->
        <mysql.version>8.0.33</mysql.version>
        <!-- PostgreSQL版本 -->
        <postgresql.version>42.7.5</postgresql.version>
        <druid.version>1.2.27</druid.version>
        
        <!-- 工具类版本 -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.40</lombok.version>
        <hutool.version>5.8.40</hutool.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        
        <!-- 调度版本 -->
        <db-scheduler.version>15.6.0</db-scheduler.version>
        
        <!-- API文档版本 -->
        <springdoc.version>1.8.0</springdoc.version>
        <swagger-annotations.version>2.2.36</swagger-annotations.version>
        
        <!-- Jackson版本 -->
        <jackson.version>2.19.2</jackson.version>
        <flyway.version>9.22.3</flyway.version>
        <slf4j.version>2.0.17</slf4j.version>
        <!-- 配置支持SLF4J 2.x的Log4j2版本 -->
        <log4j2.version>2.25.1</log4j2.version>

        <!-- Maven插件版本 -->
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <maven-clean-plugin.version>3.3.2</maven-clean-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.2</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.2</maven-deploy-plugin.version>
        <maven-site-plugin.version>4.0.0-M13</maven-site-plugin.version>
        <versions-maven-plugin.version>2.16.2</versions-maven-plugin.version>
        <flatten-maven-plugin.version>1.5.0</flatten-maven-plugin.version>
        
        <!-- SSO客户端版本 -->
        <gt-sso-client.version>3.3.3-SNAPSHOT</gt-sso-client.version>
        
        <!-- 微信支付SDK版本 -->
        <weixin-java.version>4.7.0</weixin-java.version>
        
        <!-- 解决微信支付SDK依赖冲突的版本 -->
        <guava.version>32.1.2-jre</guava.version>
        <commons-io.version>2.14.0</commons-io.version>
    </properties>

    <dependencyManagement>
