<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.noah</groupId>
        <artifactId>super-agent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>super-agent-web</artifactId>
    <name>super-agent-web</name>
    <description>Web接口模块 - Controller层</description>

    <dependencies>
        <!-- 依赖通用模块 -->
        <dependency>
            <groupId>com.noah</groupId>
            <artifactId>super-agent-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.noah</groupId>
            <artifactId>super-agent-service-impl</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>super-agent-dao</artifactId>
                    <groupId>com.noah</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring Boot Web - 使用Undertow替代Tomcat，使用Log4j2替代Logback -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 排除默认的Tomcat容器 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
                <!-- 排除默认的Logback，使用Log4j2 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        
        <!-- 引入Undertow容器 - 更高性能、更少内存占用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <exclusions>
                <!-- 排除默认的Logback，使用Log4j2 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- SSO客户端 -->

        <dependency>
            <groupId>com.norinrd</groupId>
            <artifactId>gt-sso-client-starter</artifactId>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Spring Boot Validation、Knife4j API文档 - 通过 service-impl -> common 模块传递依赖获得 -->
    </dependencies>

    <build>
        <plugins>
            <!-- Maven compiler plugin - configuration inherited from parent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>


</project>